# Jira Sprint Copilot - Environment Variables Template
# Copy this file to .env and configure your values.

# Jira Connection Settings (Used by Atlassian MCP Server)
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Default Project Configuration
DEFAULT_BOARD_ID=1001
DEFAULT_PROJECT_KEY=ENG

# AI Model Override (Optional: defaults to framework configuration)
CODEX_MODEL=
